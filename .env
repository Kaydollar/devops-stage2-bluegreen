# Application ports
PORT=3000
BLUE_PORT=8081
GREEN_PORT=8082

# Docker image tags (replace with your actual images)
BLUE_IMAGE=yimikaade/wonderful:devops-stage-two
GREEN_IMAGE=yimikaade/wonderful:devops-stage-two

# Unique release identifiers (can be any string or number)
RELEASE_ID_BLUE=blue-001
RELEASE_ID_GREEN=green-001

# Active pool - which one should Nginx route traffic to initially
ACTIVE_POOL=green

